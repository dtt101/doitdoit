pkgbase = doitdoit-bin
	pkgdesc = Keyboard-first terminal task manager with user-owned JSON storage (prebuilt binary)
	pkgver = @PKGVER@
	pkgrel = 1
	url = https://github.com/dtt101/doitdoit
	arch = x86_64
	arch = aarch64
	license = MIT
	optdepends = wl-clipboard: clipboard support on Wayland
	optdepends = xclip: clipboard support on X11
	optdepends = xsel: alternative clipboard support on X11
	provides = doitdoit=@PKGVER@
	conflicts = doitdoit
	options = !debug
	source_x86_64 = doitdoit-bin-@PKGVER@-x86_64.tar.gz::https://github.com/dtt101/doitdoit/releases/download/v@PKGVER@/doitdoit_Linux_x86_64.tar.gz
	sha256sums_x86_64 = @X86_64_SHA256@
	source_aarch64 = doitdoit-bin-@PKGVER@-aarch64.tar.gz::https://github.com/dtt101/doitdoit/releases/download/v@PKGVER@/doitdoit_Linux_arm64.tar.gz
	sha256sums_aarch64 = @AARCH64_SHA256@

pkgname = doitdoit-bin

# Maintainer: David Thompson
# Packaging files are available under the 0BSD license.

pkgname=doitdoit-bin
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Keyboard-first terminal task manager with user-owned JSON storage (prebuilt binary)'
arch=('x86_64' 'aarch64')
url='https://github.com/dtt101/doitdoit'
license=('MIT')
provides=("doitdoit=${pkgver}")
conflicts=('doitdoit')
options=('!debug')
optdepends=(
  'wl-clipboard: clipboard support on Wayland'
  'xclip: clipboard support on X11'
  'xsel: alternative clipboard support on X11'
)
source_x86_64=("${pkgname}-${pkgver}-x86_64.tar.gz::https://github.com/dtt101/doitdoit/releases/download/v${pkgver}/doitdoit_Linux_x86_64.tar.gz")
source_aarch64=("${pkgname}-${pkgver}-aarch64.tar.gz::https://github.com/dtt101/doitdoit/releases/download/v${pkgver}/doitdoit_Linux_arm64.tar.gz")
sha256sums_x86_64=('@X86_64_SHA256@')
sha256sums_aarch64=('@AARCH64_SHA256@')

package() {
  install -Dm755 doitdoit "${pkgdir}/usr/bin/doitdoit"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md "${pkgdir}/usr/share/licenses/${pkgname}/THIRD_PARTY_NOTICES.md"
}

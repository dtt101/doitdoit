  "scenarios": [
    {
      "name": "equal offline imports coalesce",
      "delivery": [
        "base",
        "same",
        "active_same",
        "active"
      ],
      "expected": {
        "pending": [],
        "conflicts": [],
        "snapshot": {
          "Future": [
            {
              "id": "task-a",
              "title": "Buy milk",
              "completed": false,
              "created_at": "2026-09-07T09:00:00Z",
              "due_date": ""
            }
          ]
        },
        "unique_imports": 1,
        "completion_events": 0
      }
    },
    {
      "name": "unequal offline imports preserve alternatives",
      "delivery": [
        "base",
        "active",
        "other",
        "active_other"
      ],
      "expected": {
        "pending": [],
        "conflicts": [
          {
            "buckets": [
              "Future"
            ],
            "alternatives": [
              "base",
              "other"
            ]
          }
        ],
        "snapshot": null,
        "unique_imports": 2,
        "completion_events": 0
      }
    },
    {
      "name": "activation and change wait for missing import",
      "delivery": [
        "complete",
        "active"
      ],
      "expected": {
        "pending": [
          "active",
          "complete"
        ],
        "conflicts": [],
        "snapshot": null
      },
      "then": {
        "delivery": [
          "base"
        ],
        "expected": {
          "pending": [],
          "conflicts": [],
          "snapshot": {
            "Future": [
              {
                "id": "task-a",
                "title": "Buy milk",
                "completed": true,
                "created_at": "2026-09-07T09:00:00Z",
                "due_date": ""
              }
            ]
          },
          "completion_events": 1
        }
      }
    },
    {
      "name": "late legacy write cannot overwrite new completion",
      "delivery": [
        "base",
        "active",
        "complete",
        "other",
        "active_other"
      ],
      "expected": {
        "pending": [],
        "conflicts": [
          {
            "buckets": [
              "Future"
            ],
            "alternatives": [
              "complete",
              "other"
            ]
          }
        ],
        "snapshot": null,
        "completion_events": 1
      }
    },
    {
      "name": "absence in late snapshot is not deletion",
      "delivery": [
        "base",
        "active",
        "empty",
        "active_empty"
      ],
      "expected": {
        "pending": [],
        "conflicts": [],
        "snapshot": {
          "Future": [
            {
              "id": "task-a",
              "title": "Buy milk",
              "completed": false,
              "created_at": "2026-09-07T09:00:00Z",
              "due_date": ""
            }
          ]
        },
        "unique_imports": 2,
        "completion_events": 0
      }
    },
    {
      "name": "backup arrival is also a dependency",
      "withhold_raw": [
        "original"
      ],
      "delivery": [
        "base",
        "active"
      ],
      "expected": {
        "pending": [
          "active"
        ],
        "conflicts": [],
        "snapshot": null
      },
      "then": {
        "delivery": [],
        "raw": [
          "original"
        ],
        "expected": {
          "pending": [],
          "conflicts": [],
          "snapshot": {
            "Future": [
              {
                "id": "task-a",
                "title": "Buy milk",
                "completed": false,
                "created_at": "2026-09-07T09:00:00Z",
                "due_date": ""
              }
            ]
          },
          "completion_events": 0
        }
      }
    },
    {
      "name": "concurrent delete and completion require explicit resolution",
      "delivery": [
        "base",
        "active",
        "complete",
        "deleted"
      ],
      "expected": {
        "pending": [],
        "conflicts": [
          {
            "buckets": [
              "Future"
            ],
            "alternatives": [
              "complete",
              "deleted"
            ]
          }
        ],
        "snapshot": null
      },
      "then": {
        "delivery": [
          "resolved"
        ],
        "expected": {
          "pending": [],
          "conflicts": [],
          "snapshot": {},
          "completion_events": 1
        }
      }
    }

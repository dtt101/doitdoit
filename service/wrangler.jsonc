{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doitdoit-service-local",
  "main": "build/worker/shim.mjs",
  "build": {
    "command": ".tools/bin/worker-build --release --no-panic-recovery",
    "watch_dir": ["rust", "Cargo.toml", "Cargo.lock"],
  },
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "SERVICE_ORIGIN": "http://localhost:8787",
    "OWNER_TIMEZONE": "Europe/London",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "doitdoit-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
